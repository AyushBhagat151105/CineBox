{
  "name": "cinebox",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "axios": "^1.21.0",
    "crypto-js": "^4.2.0",
    "expo": "~58.0.20",
    "expo-constants": "~58.0.13",
    "expo-crypto": "^58.0.7",
    "expo-file-system": "^58.0.12",
    "expo-font": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-navigation-bar": "^58.0.4",
    "expo-router": "~58.0.27",
    "expo-screen-orientation": "~58.0.3",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-video": "^58.0.12",
    "expo-web-browser": "~58.0.7",
    "lucide-react-native": "^1.63.0",
    "node-html-parser": "^9.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android --device",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:apk": "cd android && ./gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a && cd .. && cp android/app/build/outputs/apk/release/app-release.apk ./CineBox-v1.0.0-release.apk",
    "build:apk:all": "cd android && ./gradlew assembleRelease && cd .. && cp android/app/build/outputs/apk/release/app-release.apk ./CineBox-v1.0.0-all-arch.apk",
    "build:apk:debug": "cd android && ./gradlew assembleDebug -PreactNativeArchitectures=arm64-v8a && cd .. && cp android/app/build/outputs/apk/debug/app-debug.apk ./CineBox-debug.apk",
    "install:apk": "adb install -r ./CineBox-v1.0.0-release.apk"
  },
  "private": true
}